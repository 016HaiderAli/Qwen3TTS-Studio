# Voice Studio backend configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Core ---
# APP_NAME=Voice Studio
# DEBUG=false

# The public origin the browser uses (used to build the Google redirect URI
# when GOOGLE_REDIRECT_URI is empty).
FRONTEND_URL=http://localhost:5173

# If your Google Cloud OAuth client registers a specific redirect URI, set it
# here (e.g. https://app.example.com/auth/callback). It must exactly match what
# you registered in Google Cloud Console.
# GOOGLE_REDIRECT_URI=

# --- Database (SQLite by default) ---
# DATABASE_URL=sqlite:///./data/voice_studio.db

# --- Storage ---
# STORAGE_DIR=./storage

# --- Google OAuth (required for real login) ---
# Create an OAuth client in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include your GOOGLE_REDIRECT_URI (or
# FRONTEND_URL + /auth/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sessions ---
# SESSION_COOKIE_NAME=vs_session
# SESSION_TTL_SECONDS=604800
# Set to 1 when serving over HTTPS.
COOKIE_SECURE=0

# --- Worker ---
# Shared secret the GPU worker uses to authenticate to the internal API.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_TOKEN=

# Worker capability that web-tier jobs are tagged with (and can therefore be
# claimed by). "qwen" = real GPU worker (default), "mock" = mock worker (preview).
# start.sh sets this from WORKER_BACKEND automatically; set it here only if you
# run the backend outside start.sh with a mock worker.
# DEFAULT_JOB_BACKEND=qwen

# Lease (seconds) after which a "running" job is considered stale and recovered
# (requeued, or failed once max attempts are exhausted). 1800 (30 min) is the
# safe default for the one-job-at-a-time worker.
# JOB_LEASE_SECONDS=1800

# --- Dev login (test only, NEVER enable in production) ---
# DEV_LOGIN=0

# --- CORS extra origins (comma separated) ---
# CORS_ORIGINS=
