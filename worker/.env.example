# Voice Studio GPU worker configuration. Copy to .env (not committed).
# The worker ONLY needs these values; it never receives DB/storage/OAuth secrets.
#
# Run the worker from the repo's worker/ directory so the module is importable:
#   cd worker
#   WORKER_TOKEN=... BACKEND_URL=... WORKER_BACKEND=qwen python -m qwen_tts_worker.main
# With --backend qwen the worker first runs GPU environment checks
# (qwen_tts_worker/checks.py) and aborts with actionable errors if the host
# cannot run qwen-tts.

# Backend internal API base URL (the FastAPI app).
BACKEND_URL=http://localhost:8000

# Bearer token the backend's WORKER_TOKEN env var must match.
WORKER_TOKEN=

# Backend selection: mock | qwen
#   mock - synthetic audio, no GPU/torch (validates the full web-tier flow)
#   qwen - real Qwen3-TTS on a CUDA GPU (see requirements-qwen.txt)
WORKER_BACKEND=mock

# Polling
POLL_INTERVAL_SECONDS=2.0
REQUEST_TIMEOUT_SECONDS=120.0

# Mock backend
MOCK_SAMPLE_RATE=24000

# Qwen backend (GPU host)
# QWEN_MODEL_DESIGN=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# QWEN_MODEL_BASE=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN_DEVICE=cuda:0
# QWEN_DTYPE=bfloat16
# Keeping the design model loaded makes it stay resident while the Base model is
# later loaded for narration, so BOTH checkpoints share VRAM. Only set this after
# confirming the GPU actually fits both (never assumed).
# QWEN_KEEP_DESIGN_LOADED=false
